		"alchemy": "2.0.0-beta.85",
		"effect": "4.1.2",
		"oxfmt": "0.76.0",
		"turbo": "2.11.10",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"@alchemy.run/cloudflare": ">=2.0.0-beta.85",
